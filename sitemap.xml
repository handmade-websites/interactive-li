<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <!-- Every URL lists the full set of alternates, including itself, as the
       hreflang spec requires. The bare URL is both the x-default and the
       English variant: English is the default copy, so ?lang=en would be a
       second address for a page identical to this one. -->

  <url>
    <loc>https://interactive.li/</loc>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://interactive.li/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://interactive.li/"/>
    <xhtml:link rel="alternate" hreflang="de" href="https://interactive.li/?lang=de"/>
    <xhtml:link rel="alternate" hreflang="fr" href="https://interactive.li/?lang=fr"/>
    <lastmod>2026-08-15</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>https://interactive.li/?lang=de</loc>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://interactive.li/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://interactive.li/"/>
    <xhtml:link rel="alternate" hreflang="de" href="https://interactive.li/?lang=de"/>
    <xhtml:link rel="alternate" hreflang="fr" href="https://interactive.li/?lang=fr"/>
    <lastmod>2026-08-15</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>https://interactive.li/?lang=fr</loc>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://interactive.li/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://interactive.li/"/>
    <xhtml:link rel="alternate" hreflang="de" href="https://interactive.li/?lang=de"/>
    <xhtml:link rel="alternate" hreflang="fr" href="https://interactive.li/?lang=fr"/>
    <lastmod>2026-08-15</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- poster.html exists in English only, so it lists no alternates: an
       hreflang set naming variants that do not exist would be a false claim. -->
  <url>
    <loc>https://interactive.li/poster.html</loc>
    <lastmod>2026-08-15</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.6</priority>
  </url>

</urlset>
